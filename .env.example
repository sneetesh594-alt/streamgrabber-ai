# Clipper Environment Configuration
# Copy this to .env and edit as needed

# --- Paths ---
CLIPPER_OUTPUT_DIR=./output
CLIPPER_TEMP_DIR=./temp
CLIPPER_MODELS_DIR=./models

# --- Video Download ---
CLIPPER_MAX_VIDEO_LENGTH_MINUTES=1440
CLIPPER_PREFERRED_QUALITY=720p

# --- Whisper ---
CLIPPER_WHISPER_MODEL=base
# CLIPPER_WHISPER_LANGUAGE=en  # Set to auto-detect if unset

# --- Scoring Weights (must sum to 1.0) ---
CLIPPER_WEIGHT_AUDIO=0.30
CLIPPER_WEIGHT_TEXT=0.35
CLIPPER_WEIGHT_VISUAL=0.35

# --- Clip Settings ---
CLIPPER_MAX_CLIPS=10
CLIPPER_CLIP_DURATION_TARGET_SEC=30
CLIPPER_CLIP_DURATION_MIN_SEC=20
CLIPPER_CLIP_DURATION_MAX_SEC=45

# --- Output Resolution (9:16 vertical) ---
CLIPPER_OUTPUT_WIDTH=1080
CLIPPER_OUTPUT_HEIGHT=1920
CLIPPER_OUTPUT_FPS=30

# --- Scene Detection ---
CLIPPER_SCENE_THRESHOLD=27.0

# Release models between inference and portrait encoding on small CPU hosts.
CLIPPER_LOW_MEMORY=true

# --- CLIP ---
CLIPPER_CLIP_SAMPLE_FPS=1.0

# --- Face Tracking ---
CLIPPER_TRACKER_TYPE=CSRT
CLIPPER_FACE_DETECTION_CONFIDENCE=0.7

# Server secrets only. Use newly rotated Google Gemini keys.
GEMINI_API_KEY=
SECOND_AI_API_KEY=
GEMINI_REVIEW_ENABLED=false
GEMINI_DAILY_REQUEST_LIMIT=12
# Google Application Default Credentials for reading key ownership & project billing
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/billing-reader.json
# YTDLP_COOKIEFILE=/etc/secrets/cookies.txt
# STREAMGRABBER_STATE_DIR=/path/to/persistent/streamgrabber-state
# PUBLIC_BASE_URL=https://your-public-worker.example
# Full inspects consecutive timeline sections. Quick samples throughout the selected range.
CLIPPER_SCAN_MODE=full
CLIPPER_SCAN_BUDGET=14
# For a self-hosted worker with enough disk, raise the browser upload limit as required.
STREAMGRABBER_UPLOAD_MB=90
CLIPPER_ENABLE_OVERLAY=true
CLIPPER_CREATOR_TAG=

# Backend secrets from a Groq organization on the Free plan; all four share limits.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_CONFIRMED_FREE_PLAN=false
